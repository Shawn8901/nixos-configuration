{
  "$schema": "https://opencode.ai/config.json",
   "model": "llama-cpp/qwen3.8-27b",
  "providers": {
    "llama-cpp": {
      "name": "llama.cpp",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://127.0.0.1:8080/",
        "apiKey": "sk-dummy"
      },
      "models": {
        "qwen3.8-27b": {
          "modelID": "qwen3.8-27b",
          "name": "Qwen3.8-27B-UD-Q3_K_XL",
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"]
          },
          "limit": {
            "context": 131072,
            "output": 8192
          }
        }
      }
    }
  },
  "mcp": {
    "servers": {
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp"
      }
    }
  }
}
